# ==================== Agent 服务 ====================
AGENT_PORT=3002
AGENT_NODE_ENV=development

# ==================== DeepSeek API ====================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==================== 认证 ====================
JWT_SECRET=<与 apps/server/.env 共享>

# ==================== 平台 API ====================
SERVER_API_BASE_URL=http://localhost:3000

# ==================== CORS ====================
AGENT_CORS_ORIGIN=http://localhost:5173

# ==================== 速率限制 ====================
AGENT_RATE_LIMIT=20
AGENT_MAX_CONCURRENT=10

# ==================== 会话 ====================
# 会话存储后端：memory（进程内，重启丢）| sqlite（本地文件）| mysql（与 checkpoint 共库，重启可续）。
# mysql 复用下方 AGENT_DATABASE_URL；需先建 agent_sessions 表（apps/server `db push` 或运行时自动建表）。
# 回退开关：改回 memory/sqlite 即回滚。
SESSION_STORE=sqlite
SESSION_TTL_HOURS=6

# 执行权租约（仅 SESSION_STORE=mysql 时生效）：多副本互斥 + 崩溃自愈。owner 为进程级实例 id。
# 关闭：SESSION_LEASE_ENABLED=false；彻底回滚：SESSION_STORE 改回 memory/sqlite。
SESSION_LEASE_ENABLED=true
SESSION_LEASE_TTL_MS=30000
SESSION_LEASE_HEARTBEAT_MS=10000
# 可选：多副本时给实例固定标识（默认进程启动随机生成）。
# SESSION_INSTANCE_ID=inst_1

# ==================== 上下文控制 ====================
# 工具结果进 LLM 视图的字符硬上限（兜底）。超预算先「摘要化」丢大字段，再把此值当绝对值截断
MAX_TOOL_RESULT_CHARS=8000
# 工具结果进 LLM 视图的 token 预算（阶段 4）：超预算先摘要化（丢大 schema、保 id/name），
# 仍超再按 MAX_TOOL_RESULT_CHARS 头尾硬截。CJK≈2 字符/token 近似；置 0 = 只用字符上限
MAX_TOOL_RESULT_TOKENS=2000
MAX_OUTPUT_TOKENS=2048
MAX_RETRIES=2
MAX_DEGRADE=1
# 会话记忆块 token 预算（projectMemory 单一截断口径）。L2 摘要由预算「溢出」驱动（短会话零摘要）；
# 置 0 = 关闭预算化投影（仅剩 L1 状态栏）与摘要。可选：MEMORY_REPEAT_NOTICE=true 打开重复提问提示
MEMORY_BUDGET_TOKENS=1600
# 会话累计用量软上限（阶段 4）：done.usage 超阈值时给 DONE 打 usageAlert=true，前端徽标变橙。0 = 关闭
USAGE_SOFT_LIMIT_TOKENS=0

# ==================== 只读工具结果缓存（阶段 4，Redis） ====================
# REDIS_HOST 未设 → 缓存整体 no-op（等于现状，不需 Redis）。白名单只读工具命中即短路返回。
REDIS_HOST=
REDIS_PORT=6379
TOOL_CACHE_TTL_SECONDS=60
# 关闭缓存：TOOL_CACHE_ENABLED=false
TOOL_CACHE_ENABLED=true

# ==================== Checkpoint 存储 ====================
# 必须与 apps/server/.env 的 DATABASE_URL 指向同一个库
AGENT_DATABASE_URL=mysql://root:password@localhost:3306/formpu
AGENT_DB_POOL_SIZE=5
AGENT_CHECKPOINT_AUTO_SETUP=true