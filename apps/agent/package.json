{
  "name": "@furmx/agent",
  "version": "0.1.0",
  "private": true,
  "description": "FurmX AI Agent — 受控多 Agent 图编排系统",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "test": "vitest run --config vitest.config.mts",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "test:checkpoint": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@furmx/sdk": "workspace:*",
    "@langchain/core": "^1.2.11",
    "@langchain/deepseek": "^1.1.13",
    "@langchain/langgraph": "1.4.15",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.0",
    "sql.js": "^1.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "mysql2": "^3.24.4",
    "openai": "^4.50.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@langchain/langgraph-checkpoint-validation": "^1.1.1",
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
