# ==================== 数据库（MySQL） ====================
DATABASE_URL=mysql://root:password@localhost:3306/formpu

# ==================== JWT ====================
# 必须与 apps/agent/.env 的 JWT_SECRET 一致（两端共享签发的 token）
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
PORT=3000

# ==================== Redis（可选） ====================
# 未设 → 缓存 / 限流计数一律回退内存（功能仍可用，多副本不共享计数）
REDIS_HOST=
REDIS_PORT=6379

# ==================== MinIO（对象存储） ====================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=furmx

# ==================== App ====================
APP_URL=http://localhost:5173

# ==================== 限流（阶段 6 / S6.1，默认关） ====================
# RATE_LIMIT_ENABLED!=='true' → 全局限流守卫直接放行（零行为变化）。
# 打开后按 工作空间 → 用户 → IP 分级限流；计数器 Redis 有则用、无则内存。超限 → HTTP 429。
RATE_LIMIT_ENABLED=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120

# ==================== 工作空间配额（阶段 6 / S6.1，默认关） ====================
# QUOTA_ENABLED!=='true' → 配额守卫直接放行。打开后按 Workspace.maxForms/maxMembers 校验
# （<=0 表示不限）；建表 / 邀请成员超限 → HTTP 429。
QUOTA_ENABLED=false

# ==================== 密钥托管（阶段 6 / S6.2，OpenBao，可选） ====================
# OPENBAO_ADDR + OPENBAO_TOKEN 都设了才启用：启动时从 OpenBao 拉取密钥并填充缺失的 env
# （真 env 优先，不覆盖已存在的值）。开发环境拉取失败仅告警继续；生产（NODE_ENV=production）失败即终止启动。
OPENBAO_ADDR=
OPENBAO_TOKEN=
# KV-v2 默认路径；Vault KV-v1 用 secret/furmx
OPENBAO_SECRET_PATH=secret/data/furmx
